// Reference only; wrangler.toml is the active Pages configuration.
// Copy a REAL Hyperdrive binding to wrangler.toml after provisioning the database.
// Do not leave this placeholder in an active config; disable Hyperdrive caching.
{
  "name": "cervancom",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_WITH_REAL_HYPERDRIVE_ID" }],
  "vars": { "CERPLUS_ORIGIN": "https://cervanlojistik.com" }
}
