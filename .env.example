# Public Web3Forms form key for info@cervanlojistik.com.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional external Cerplus URL; same site uses /cerplus/ by default.
PUBLIC_CERPLUS_URL=

# Cerplus development (Node 24+). Empty DATABASE_URL uses local PGlite.
CERPLUS_MODE=development
CERPLUS_ORIGIN=http://localhost:4321
CERPLUS_PORT=4322
CERPLUS_DATA_DIR=.cerplus/development
DATABASE_URL=

# First-admin bootstrap into an EMPTY operational database only.
# Remove the password from the environment after running cerplus:admin.
CERPLUS_ADMIN_NAME=
CERPLUS_ADMIN_EMAIL=
CERPLUS_ADMIN_PASSWORD=

# Dedicated TEST database, never production.
CERPLUS_TEST_DATABASE_URL=
