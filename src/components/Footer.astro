---
import { site } from '../config/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand brand-light" href="/" aria-label={`${site.name} ana sayfa`}>
        <img
          class="brand-logo"
          src="/cervandisi.png"
          alt="Cervan Lojistik, Depolama ve Montaj"
          width="3035"
          height="819"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="footer-copy"><strong>Cervan Lojistik</strong><br />Ankara merkezli, Türkiye genelinde lojistik, depolama ve mobilya montaj hizmetleri.</p>
    </div>
    <div class="footer-links">
      <span class="footer-label">Hızlı erişim</span>
      <a href="/">Ana Sayfa</a>
      <a href="/hakkimizda/">Hakkımızda</a>
      <a href="/hizmetler/">Hizmetler</a>
      <a href="/iletisim/">İletişim</a>
      <a href="/kvkk/">KVKK Aydınlatma Metni</a>
    </div>
    <div class="footer-links">
      <span class="footer-label">İletişim</span>
      <a href={site.contact.phoneHref}>{site.contact.phone}</a>
      <a href={site.contact.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp'tan Yazın <span aria-hidden="true">↗</span></a>
      <a href={site.contact.instagram} target="_blank" rel="noopener noreferrer">{site.contact.instagramHandle} <span aria-hidden="true">↗</span></a>
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {site.seoName}. Tüm hakları saklıdır.</span>
    <span>Güvenli taşımanın doğru adresi.</span>
  </div>
</footer>
