---
import { site } from '../config/site';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
  { href: '/', label: 'Ana Sayfa' },
  { href: '/hakkimizda/', label: 'Hakkımızda' },
  { href: '/hizmetler/', label: 'Hizmetler' },
  { href: '/demo/', label: 'Cerplus' },
  { href: '/iletisim/', label: 'İletişim' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name} ana sayfa`}>
      <img
        class="brand-logo brand-logo-default"
        src="/cervan.png"
        alt="Cervan Lojistik, Depolama ve Montaj"
        width="3034"
        height="818"
        decoding="async"
      />
      <img
        class="brand-logo brand-logo-inverse"
        src="/cervandisi.png"
        alt=""
        width="3035"
        height="819"
        decoding="async"
        aria-hidden="true"
      />
    </a>

    <nav class="desktop-nav" aria-label="Ana menü">
      {links.map((link) => (
        <a href={link.href} aria-current={currentPath === (link.href.replace(/\/+$/, '') || '/') ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <a class="button button-small header-cta" href={site.cerplusUrl}>
      Cerplus’a Giriş <span aria-hidden="true">↗</span>
    </a>
    <a class="header-whatsapp" href={site.contact.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp'tan Teklif Al" title="WhatsApp'tan Teklif Al">WhatsApp ↗</a>

    <details class="mobile-menu">
      <summary aria-label="Menüyü aç veya kapat"><span>Menü</span><i aria-hidden="true"></i></summary>
      <nav aria-label="Mobil menü">
        {links.map((link) => (
          <a href={link.href} aria-current={currentPath === (link.href.replace(/\/+$/, '') || '/') ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
        <a class="button" href={site.cerplusUrl}>Cerplus’a Giriş <span aria-hidden="true">↗</span></a>
        <a href={site.contact.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp'tan Teklif Al ↗</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .header-whatsapp { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; color: #258976; font-size: 12px; font-weight: 800; white-space: nowrap; }
  .has-overlay-header .site-header:not(.is-scrolled) .header-whatsapp { color: #7ae1d7; }
  @media (min-width: 1051px) { .header-inner { gap: 22px; } }
  @media (max-width: 1050px) { .header-whatsapp { display: none; } }
</style>
