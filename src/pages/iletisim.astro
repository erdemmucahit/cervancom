---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { services, site } from '../config/site';
import heroImage from '../assets/hero-contact.png';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY?.trim() || '';
---

<BaseLayout title="İletişim ve Teklif | Cervan Lojistik" description="Cervan Lojistik’in mobilya depolama, nakliye ve kurulum hizmetleri için iletişime geçin ve teklif talep edin." overlayHeader>
  <PageHero
    eyebrow="İletişim"
    description="İhtiyacınızı paylaşın; taşıma ve kurulum sürecinizi birlikte planlayalım."
    image={heroImage}
    alt="Lojistik planını müşteriyle değerlendiren Cervan çalışanı"
  >
    Depolama ve Montaj Çözümlerimiz İçin <em>Bize Ulaşın</em>
  </PageHero>
  <section class="section contact-section" id="page-content">
    <div class="container contact-grid">
      <div class="contact-details">
        <p class="eyebrow"><span></span> Cervan</p>
        <h2>{site.location} merkezli, <em>Türkiye geneli</em> hizmet.</h2>
        <p>Taşıma, depolama ve kurulum ihtiyaçlarınız için bize e-posta ile ulaşabilirsiniz.</p>
        <p><a class="contact-email" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
        <div class="contact-facts">
          <div><span>Merkez</span><strong>{site.location}</strong></div>
          <div><span>Hizmet bölgesi</span><strong>{site.serviceArea}</strong></div>
        </div>
      </div>
      <div class="map-frame"><iframe title="Cervan merkez konumu" src="https://www.google.com/maps?q=40.104789,32.629454&z=17&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
    </div>
  </section>
  <section class="section quote-section" id="teklif">
    <div class="container quote-grid">
      <div>
        <p class="eyebrow"><span></span> Hızlı teklif</p>
        <h2>Size özel planı <em>başlatalım.</em></h2>
        <p>Formdaki bilgilerle ihtiyacınızı değerlendirebilir ve en doğru hizmet planını oluşturabiliriz.</p>
      </div>
      <form class="quote-form" id="quote-form" action="https://api.web3forms.com/submit" method="POST" aria-describedby="quote-status">
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="Cervan | Yeni teklif talebi" />
        <input type="hidden" name="from_name" value="Cervan Lojistik" />
        <div class="form-row">
          <label>Ad soyad<input name="name" autocomplete="name" minlength="2" maxlength="100" required /></label>
          <label>Telefon<input name="phone" type="tel" autocomplete="tel" maxlength="30" required /></label>
        </div>
        <div class="form-row">
          <label>E-posta<input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
          <label>Hizmet türü<select name="service" required><option value="">Seçiniz</option>{services.map((service) => <option value={service.title}>{service.title}</option>)}</select></label>
        </div>
        <label>Notunuz<textarea name="message" rows="4" maxlength="4000" placeholder="Taşınacak eşya veya kurulum ihtiyacınızı kısaca yazın."></textarea></label>
        <div class="form-honeypot" aria-hidden="true" inert>
          <label>Bu alanı boş bırakın<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button class="button" type="submit" disabled={!accessKey}><span data-submit-label>Teklif talep et</span> <span aria-hidden="true">↗</span></button>
        <p class="form-status" id="quote-status" role="status" aria-live="polite" aria-atomic="true" data-state={accessKey ? '' : 'error'}>
          {!accessKey && 'Teklif formu şu anda kullanılamıyor. Bize e-posta ile ulaşabilirsiniz.'}
        </p>
      </form>
    </div>
  </section>
  <script>
    import '../scripts/quote-form';
  </script>
</BaseLayout>
