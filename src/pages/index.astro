---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import logisticsImage from '../assets/service-logistics.png';
import storageImage from '../assets/service-storage.png';
import installationImage from '../assets/service-installation.png';
import teamImage from '../assets/about-team.png';

const slides = [
  {
    eyebrow: 'Türkiye geneli taşımacılık',
    title: 'Lojistik',
    description:
      'Şehir içi ve şehirlerarası yüklerinizi doğru planlama, güvenli taşıma ve zamanında teslimatla yönetiyoruz.',
    image: logisticsImage,
    alt: 'Anadolu yolunda ilerleyen modern lojistik aracı',
  },
  {
    eyebrow: 'Düzenli ve güvenli alanlar',
    title: 'Depolama',
    description:
      'Ürün ve mobilyalarınız için düzenli, kontrollü ve ihtiyaçlarınıza uyarlanan depolama çözümleri sunuyoruz.',
    image: storageImage,
    alt: 'Düzenli rafları bulunan modern depolama tesisi',
  },
  {
    eyebrow: 'Teslimattan son dokunuşa',
    title: 'Montaj',
    description:
      'Mobilyalarınızı uzman ekibimizle dikkatle taşıyor, yerinde montaj ve demontaj süreçlerini tamamlıyoruz.',
    image: installationImage,
    alt: 'Modern bir evde mobilya kurulumu yapan profesyonel ekip',
  },
] as const;

const serviceCards = [
  {
    title: 'Lojistik',
    description:
      'Şehir içi ve şehirlerarası taşımaları, yükün niteliğine uygun araç ve planlamayla gerçekleştiriyoruz.',
    features: ['Türkiye geneli hizmet', 'Planlı sevkiyat', 'Kontrollü teslimat'],
  },
  {
    title: 'Depolama',
    description:
      'Mobilya ve yükleriniz için düzenli alan, kontrollü yerleşim ve sevkiyata hazır operasyon desteği sağlıyoruz.',
    features: ['Düzenli yerleşim', 'Güvenli muhafaza', 'Esnek süreç'],
  },
  {
    title: 'Montaj',
    description:
      'Mobilya söküm, paketleme, taşıma ve yeniden kurulum adımlarını deneyimli ekibimizle tek elden yönetiyoruz.',
    features: ['Montaj ve demontaj', 'Koruyucu paketleme', 'Yerinde teslim'],
  },
] as const;
---

<BaseLayout
  title="Cervan | Lojistik, Depolama ve Kurulum"
  description="Cervan ile Türkiye genelinde lojistik, depolama ve mobilya kurulum hizmetleri."
  overlayHeader
>
  <section class="home-slider" data-service-slider data-overlay-hero aria-label="Cervan hizmetleri">
    <h1 class="sr-only">Cervan lojistik, depolama ve mobilya kurulum hizmetleri</h1>

    <div class="home-slides" aria-live="polite">
      {slides.map((slide, index) => (
        <article
          class:list={['home-slide', { 'is-active': index === 0 }]}
          data-slide={index}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <Image
            class="home-slide-image"
            src={slide.image}
            alt={slide.alt}
            widths={[640, 960, 1440, 1920]}
            sizes="100vw"
            quality={82}
            loading={index === 0 ? 'eager' : 'lazy'}
          />
          <div class="home-slide-shade"></div>
          <div class="container home-slide-content">
            <p class="home-slide-eyebrow">{slide.eyebrow}</p>
            <h2>{slide.title}</h2>
            <p>{slide.description}</p>
            <a class="hero-button" href="/hizmetler/">
              Hizmeti incele <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <button class="slider-arrow slider-arrow-prev" type="button" data-slider-prev aria-label="Önceki hizmet">
      <span aria-hidden="true">←</span>
    </button>
    <button class="slider-arrow slider-arrow-next" type="button" data-slider-next aria-label="Sonraki hizmet">
      <span aria-hidden="true">→</span>
    </button>

    <div class="container slider-tabs" role="tablist" aria-label="Hizmet seçimi">
      {slides.map((slide, index) => (
        <button
          class:list={['slider-tab', { 'is-active': index === 0 }]}
          type="button"
          role="tab"
          data-slide-to={index}
          aria-selected={index === 0 ? 'true' : 'false'}
        >
          <strong>{slide.title}</strong>
        </button>
      ))}
    </div>

    <a class="scroll-cue" href="#hizmetler" aria-label="Hizmetler bölümüne kaydır">
      <span>Keşfet</span><i aria-hidden="true"></i>
    </a>
  </section>

  <section class="home-services" id="hizmetler">
    <div class="container">
      <div class="home-section-heading">
        <div>
          <p class="eyebrow"><span></span> Neler yapıyoruz?</p>
          <h2>Taşımanın üç temel adımını <em>tek ekipte</em> buluşturuyoruz.</h2>
        </div>
        <p>İhtiyacınızı dinliyor, yükünüz için doğru operasyonu planlıyor ve süreci teslimata kadar takip ediyoruz.</p>
      </div>

      <div class="home-service-grid">
        {serviceCards.map((service) => (
          <article class="home-service-card">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <ul>
              {service.features.map((feature) => <li>{feature}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-about">
    <div class="home-about-media">
      <Image
        src={teamImage}
        alt="Cervan lojistik ve kurulum ekibi"
        widths={[640, 960, 1280]}
        sizes="(max-width: 900px) 100vw, 52vw"
        quality={84}
      />
      <div class="home-about-badge"><strong>81</strong><span>ilde hizmet</span></div>
    </div>
    <div class="home-about-copy">
      <h2>Her yükü kendi sorumluluğumuz gibi <em>taşıyoruz.</em></h2>
      <p>Cervan, Ankara merkezli operasyonuyla lojistikten depolamaya, mobilya taşımadan kuruluma kadar tüm süreci tek ekip koordinasyonunda yönetir.</p>
      <p>Planlı çalışma, açık iletişim ve özenli uygulama anlayışımızla Türkiye’nin her noktasına güvenilir çözümler ulaştırıyoruz.</p>
      <a class="hero-button hero-button-light" href="/hakkimizda/">Bizi yakından tanıyın <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-contact" id="iletisim">
    <div class="container home-contact-heading">
      <div>
        <p class="eyebrow"><span></span> İletişim</p>
        <h2>Taşıma planınızı birlikte <em>oluşturalım.</em></h2>
      </div>
      <p>Merkezimiz Ankara’da; hizmet ağımız Türkiye’nin tamamında. İhtiyacınızı anlatın, size uygun çözümü planlayalım.</p>
    </div>

    <div class="container home-contact-grid">
      <div class="home-contact-panel">
        <div class="contact-item"><span>Merkez</span><strong>Ankara</strong></div>
        <div class="contact-item"><span>Hizmet alanı</span><strong>Türkiye geneli</strong></div>
        <div class="contact-item"><span>Çalışma alanları</span><strong>Lojistik · Depolama · Kurulum</strong></div>
        <a class="button" href="/iletisim/#teklif">Teklif alın <span aria-hidden="true">↗</span></a>
      </div>
      <div class="home-google-map">
        <iframe
          title="Cervan merkez konumu"
          src="https://www.google.com/maps?q=40.104789,32.629454&z=17&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const slider = document.querySelector<HTMLElement>('[data-service-slider]');

  if (slider) {
    const slides = [...slider.querySelectorAll<HTMLElement>('[data-slide]')];
    const tabs = [...slider.querySelectorAll<HTMLButtonElement>('[data-slide-to]')];
    const previous = slider.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const next = slider.querySelector<HTMLButtonElement>('[data-slider-next]');
    let activeIndex = 0;
    let rotation: number | undefined;

    const showSlide = (newIndex: number) => {
      activeIndex = (newIndex + slides.length) % slides.length;

      slides.forEach((slide, index) => {
        const isActive = index === activeIndex;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', String(!isActive));
      });

      tabs.forEach((tab, index) => {
        const isActive = index === activeIndex;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', String(isActive));
      });
    };

    const stopRotation = () => window.clearInterval(rotation);
    const startRotation = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      stopRotation();
      rotation = window.setInterval(() => showSlide(activeIndex + 1), 7000);
    };

    previous?.addEventListener('click', () => {
      showSlide(activeIndex - 1);
      startRotation();
    });
    next?.addEventListener('click', () => {
      showSlide(activeIndex + 1);
      startRotation();
    });
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      showSlide(Number(tab.dataset.slideTo));
      startRotation();
    }));
    slider.addEventListener('mouseenter', stopRotation);
    slider.addEventListener('mouseleave', startRotation);
    slider.addEventListener('focusin', stopRotation);
    slider.addEventListener('focusout', startRotation);
    slider.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') showSlide(activeIndex - 1);
      if (event.key === 'ArrowRight') showSlide(activeIndex + 1);
    });

    startRotation();
  }
</script>
