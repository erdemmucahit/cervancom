---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services, site } from '../config/site';
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Ankara merkezli · Türkiye geneli</p>
        <h1>Taşınmanın her adımında <em>yanınızdayız.</em></h1>
        <p class="hero-text">Ev, ofis ve mobilya taşımacılığında güvenli planlama; uzman ekip ve özenli kurulum bir arada.</p>
        <div class="hero-actions">
          <a class="button" href="#teklif">Teklif Al <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/hizmetler">Hizmetlerimizi inceleyin <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-points" aria-label="Cervan avantajları">
          <span>Planlı süreç</span><span>Özenli taşıma</span><span>Uzman kurulum</span>
        </div>
      </div>
      <div class="coverage-map-card">
        <div class="coverage-map-heading"><span>Hizmet ağımız</span><b>81 il · Türkiye geneli</b></div>
        <iframe
          title="Cervan hizmet ağı: Ankara merkezli Türkiye geneli"
          src="https://www.openstreetmap.org/export/embed.html?bbox=25.2%2C35.5%2C45.6%2C42.7&amp;layer=mapnik&amp;marker=39.9334%2C32.8597"
          loading="lazy"
        ></iframe>
        <div class="coverage-map-footer"><span class="status-dot"></span> Ankara merkezli operasyon ağı</div>
      </div>
    </div>
  </section>

  <section class="trust-strip">
    <div class="container trust-grid">
      <p>Taşınmak yalnızca eşyaları değil, <strong>hayatınızı</strong> doğru şekilde hareket ettirmektir.</p>
      <a href="/hakkimizda" class="text-link">Cervan’ı tanıyın <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section services-preview">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow"><span></span> Hizmetler</p><h2>İhtiyacınıza göre <em>planlanmış</em> çözümler.</h2></div>
        <a class="text-link desktop-only" href="/hizmetler">Tüm hizmetler <span aria-hidden="true">→</span></a>
      </div>
      <div class="services-grid">
        {services.slice(0, 4).map((service) => (
          <article class="service-card">
            <span class="service-number">{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <a href="/hizmetler" aria-label={`${service.title} hakkında daha fazla bilgi`}>Detayları incele <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
      <a class="text-link mobile-only" href="/hizmetler">Tüm hizmetler <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="process-section">
    <div class="container process-grid">
      <div><p class="eyebrow eyebrow-light"><span></span> Nasıl çalışıyoruz?</p><h2>Net süreç, <em>rahat taşınma.</em></h2></div>
      <div class="process-list">
        <article><span>01</span><div><h3>İhtiyacınızı dinliyoruz</h3><p>Taşıma türü, tarih ve kapsamı birlikte netleştiriyoruz.</p></div></article>
        <article><span>02</span><div><h3>Taşımayı planlıyoruz</h3><p>Ekip, araç ve gerekli kurulum adımlarını organize ediyoruz.</p></div></article>
        <article><span>03</span><div><h3>Güvenle teslim ediyoruz</h3><p>Eşyalarınızı özenle taşıyor, gerekiyorsa yerinde kuruyoruz.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section quote-section" id="teklif">
    <div class="container quote-grid">
      <div><p class="eyebrow"><span></span> Hızlı teklif</p><h2>Taşınma planınızı birlikte <em>oluşturalım.</em></h2><p>İhtiyacınızı paylaşın; sizin için en uygun taşıma ve kurulum planını hazırlayalım.</p><div class="quote-note"><span>✦</span><p>{site.location} merkezli ekibimizle, {site.serviceArea.toLocaleLowerCase('tr-TR')} hizmet veriyoruz.</p></div></div>
      <form class="quote-form" id="quote-form">
        <div class="form-row"><label>Ad soyad<input name="name" autocomplete="name" required /></label><label>Telefon<input name="phone" type="tel" autocomplete="tel" required /></label></div>
        <div class="form-row"><label>E-posta<input name="email" type="email" autocomplete="email" required /></label><label>Hizmet türü<select name="service" required><option value="">Seçiniz</option>{services.map((service) => <option value={service.title}>{service.title}</option>)}</select></label></div>
        <div class="form-row"><label>Taşıma tarihi<input name="date" type="date" /></label><label>Taşıma güzergâhı<input name="route" placeholder="Örn. Ankara → İzmir" /></label></div>
        <label>Notunuz<textarea name="message" rows="3" placeholder="Taşınacak eşya veya kurulum ihtiyacınızı kısaca yazın."></textarea></label>
        <button class="button" type="submit">Teklif talep et <span aria-hidden="true">↗</span></button>
        <p class="form-status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#quote-form');
  const status = document.querySelector<HTMLElement>('.form-status');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    if (status) status.textContent = 'Teklif formu e-posta altyapısı bağlandığında talebiniz doğrudan ekibimize iletilecek.';
  });
</script>
