---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { services } from '../config/site';
import heroImage from '../assets/hero-services.png';
---

<BaseLayout title="Mobilya Depolama ve Montaj | Cervan Lojistik" description="Cervan Lojistik’ten mobilya üreticileri ve dağıtıcılarına özel depolama, montaj, demontaj, paketleme ve nakliye hizmetleri." overlayHeader>
  <PageHero
    eyebrow="Hizmetler"
    description="Mobilyalarınızı üretimden depolamaya, sevkiyattan son kullanıcı kurulumuna kadar profesyonel bir operasyonla yönetiyoruz."
    image={heroImage}
    alt="Depoda yükleme ve mobilya taşıma operasyonu"
  >
    Taşımacılığın her aşaması için <em>tek ekip.</em>
  </PageHero>
  <section class="section service-list-section" id="page-content">
    <div class="container service-list">
      {services.map((service) => (
        <article>
          <div>
            <h2>{service.title}</h2>
            <p>{service.description}</p>
          </div>
          <a class="service-arrow" href="/iletisim/#teklif" aria-label={`${service.title} için teklif al`}>↗</a>
        </article>
      ))}
    </div>
  </section>
  <section class="cta-band">
    <div class="container cta-band-inner">
      <div class="cta-band-copy">
        <span class="cta-band-kicker">Yeni bir proje mi planlıyorsunuz?</span>
        <p>Mobilyalarınız için depolamadan kuruluma uzanan doğru operasyonu birlikte oluşturalım.</p>
      </div>
      <a class="button cta-band-button" href="/iletisim/#teklif">
        Teklif Al <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
