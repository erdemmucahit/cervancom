---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import '../styles/cerplus-presentation.css';

const capabilities = [
  { number: '01', name: 'Ürün & koli kataloğu', title: 'Mobilyanın bütününü, her kolisiyle tanıyın.', text: 'Marka, ürün kodu, model ve varyant aynı katalogda. Çok kolili ürünlerin her koli tipini; barkodu, gereken adedi, hacmi ve ağırlığıyla tanımlayın.', detail: 'Ürün kodu → Koli tipleri → Marka bağlamlı barkod', tag: 'Mobilyaya özel ürün yapısı' },
  { number: '02', name: 'Mal kabul', title: 'Depoya giren koli, kayda da girsin.', text: 'Barkod okutarak, elle girerek veya Excel yükleyerek kabul yapın. Koli miktarını, yerleştirildiği rafı ve stok sahibini onaylamadan önce görün.', detail: 'Okut → Miktarı kontrol et → Kabulü onayla', tag: 'Barkod · Manuel · Excel' },
  { number: '03', name: 'Stok & raf yönetimi', title: '“Depoda var” bilgisinin bir adım ötesi.', text: 'Hangi koli hangi rafta, hangi bayiye ait? Fiziksel ve kullanılabilir miktarları ayrı izleyin. Bayi stoğu ile ortak depo stoğunu aynı görünümde ayırt edin.', detail: 'Koli tipi + Raf + Stok sahibi', tag: 'Sahipliği belli, yeri belli stok' },
  { number: '04', name: 'Hareket & işlem geçmişi', title: 'Sonucu görün. Nasıl oluştuğunu da bilin.', text: 'Mal kabul, raf transferi ve hasar çıkışlarını kayıt altında tutun. İşlemi yapan kişi, zaman ve gerekçe üzerinden stok hareketlerinin izini sürün.', detail: 'Ne değişti? → Kim yaptı? → Ne zaman?', tag: 'İzlenebilir depo operasyonu' },
];
const roles = [
  { number: '01', name: 'Yönetici', title: 'Düzeni kurar.', text: 'Kullanıcıları, bayileri, depo bölümlerini ve rafları yönetir. Kritik işlem geçmişini takip eder.' },
  { number: '02', name: 'Depo & ofis', title: 'İşi yürütür.', text: 'Kataloğu ve mal kabulü yönetir. Stokları sorgular, raf transferi ve hasar işlemlerini kaydeder.' },
  { number: '03', name: 'Bayi', title: 'Kendi stoğunu görür.', text: 'Yalnızca kendi bayisine ait stokları ve hareketleri takip eder. Stok miktarını doğrudan değiştiremez.' },
];
const workflow = [
  ['Kataloğu tanımlayın', 'Ürünleri ve gerekli koli tiplerini kaydedin.'],
  ['Depoyu düzenleyin', 'Bölümleri, rafları ve bayileri tanımlayın.'],
  ['Kolileri kabul edin', 'Raf, sahip ve miktarı birlikte onaylayın.'],
  ['Stoğu takip edin', 'Mevcut miktarları ve hareket geçmişini görün.'],
];
const nextModules = ['Sipariş & rezervasyon', 'Randevu & sevkiyat', 'Saha & teslimat', 'Gelişmiş raporlar & entegrasyonlar'];
---

<BaseLayout title="Cerplus | Mobilya Deponuzun Kontrolü Elinizde — Cervan" description="Cerplus ile mobilya ürün ve koli kataloğunu, barkodla mal kabulü, bayi stoklarını ve raf hareketlerini tek bir Türkçe web uygulamasında yönetin.">
  <div class="cp-presentation">
    <section class="cp-hero" aria-labelledby="cp-title">
      <div class="container cp-hero-grid">
        <div class="cp-hero-copy">
          <p class="cp-kicker"><span></span> CERVAN’DAN MOBİLYA DEPOLARINA</p>
          <div class="cp-wordmark" aria-label="Cerplus"><span class="cp-brand-mark" aria-hidden="true">c<span>+</span></span>cerplus<span class="cp-brand-dot">.</span></div>
          <h1 id="cp-title">Her koli yerinde.<br /><em>Her bilgi elinizde.</em></h1>
          <p class="cp-hero-lead">Mobilya deponuzdaki ürünleri, rafları ve bayi stoklarını tek çalışma alanında buluşturun. Ekibiniz aynı bilgiye baksın; işiniz kişilerin hafızasına bağlı kalmasın.</p>
          <div class="cp-actions"><a class="cp-button cp-button-lime" href="/iletisim/#teklif">İşletmeniz için görüşelim <span aria-hidden="true">↗</span></a><a class="cp-hero-login" href={site.cerplusUrl}>Cerplus’a giriş <span aria-hidden="true">→</span></a></div>
          <div class="cp-hero-facts"><span>Mobilyaya özel</span><span>Türkçe web arayüzü</span><span>Ofis, tablet ve telefon</span></div>
        </div>
        <figure class="cp-system-figure">
          <div class="cp-figure-top"><span class="cp-live-label"><i></i> DEPO YÖNETİMİ</span><span>İLK SÜRÜM</span></div>
          <div class="cp-box-stage" aria-hidden="true">
            <div class="cp-orbit cp-orbit-one"></div><div class="cp-orbit cp-orbit-two"></div>
            <div class="cp-carton"><div class="cp-carton-top"></div><div class="cp-carton-face"><span class="cp-carton-brand">cerplus.</span><div class="cp-carton-label"><span>KOLİ TİPİ</span><b>15–01</b><div class="cp-barcode"></div></div><span class="cp-carton-bottom">HER KOLİ BİR BİLGİ TAŞIR.</span></div><div class="cp-carton-side"></div></div>
            <div class="cp-annotation cp-annotation-rack"><span>NEREDE?</span><b>A1 rafı</b></div>
            <div class="cp-annotation cp-annotation-owner"><span>KİME AİT?</span><b>Bayi A stoğu</b></div>
            <div class="cp-annotation cp-annotation-type"><span>HANGİ PARÇA?</span><b>15–01 koli tipi</b></div>
          </div>
          <figcaption><span>Koli tipi. Rafı. Sahibi.</span><small>Ürün yapısını anlatan görsel · Operasyon verisi içermez.</small></figcaption>
        </figure>
      </div>
    </section>
    <div class="cp-value-strip"><div class="container cp-value-grid"><div><span>01</span><p><strong>Yerini bulun.</strong> Raf bazında stok görünürlüğü.</p></div><div><span>02</span><p><strong>Sahibini bilin.</strong> Bayi ve ortak stok ayrımı.</p></div><div><span>03</span><p><strong>Geçmişini görün.</strong> Kayıtlı stok hareketleri.</p></div></div></div>

    <section class="cp-section cp-problem" aria-labelledby="cp-problem-title">
      <div class="container cp-problem-grid">
        <div class="cp-editorial-copy"><p class="cp-kicker cp-kicker-dark"><span></span> MOBİLYANIN KOLİ MANTIĞINI BİLİR</p><h2 id="cp-problem-title">15 koli var.<br />Peki, <em>15’i de doğru mu?</em></h2><p>Bir gardrop, birbirinin yerine geçmeyen farklı koli tiplerinden oluşur. Aynı tipten fazladan bir koli, eksik olan başka bir tipin yerini tutmaz.</p><p>Cerplus’ta ürünler yalnızca bir isimden ibaret değildir. Gerekli koli tiplerini ve her tipten gereken adedi katalogda ayrı tanımlarsınız. Depo kaydınız mobilyanın gerçek yapısını yansıtır.</p><a class="cp-text-link" href="#cerplus-ozellikleri">Cerplus’u yakından tanıyın <span aria-hidden="true">↓</span></a></div>
        <figure class="cp-package-figure"><div class="cp-package-header"><span>ÇOK KOLİLİ ÜRÜN YAPISI</span><b>Bir gardrop / 15 koli tipi</b></div><div class="cp-package-grid" aria-label="Örnek: 01 ile 14 arasındaki koli tipleri mevcut, 15 numaralı tip eksik">{Array.from({ length: 15 }, (_, i) => <div class:list={['cp-package', { 'cp-package-missing': i === 14 }]}><span aria-hidden="true">{i === 14 ? '+' : '▱'}</span><b>15–{String(i + 1).padStart(2, '0')}</b><small>{i === 14 ? 'Eksik tip' : i === 0 ? '2 adet' : '1 adet'}</small></div>)}</div><div class="cp-package-insight"><span aria-hidden="true">!</span><p><strong>Toplam 15 koli. Yalnızca 14 farklı tip.</strong>15–01’den bir fazla olması, eksik 15–15’i tamamlamaz.</p></div><figcaption>Koli yapısını açıklayan örnek; canlı stok veya rezervasyon ekranı değildir.</figcaption></figure>
      </div>
    </section>

    <section class="cp-section cp-capabilities" id="cerplus-ozellikleri" aria-labelledby="cp-capabilities-title"><div class="container"><div class="cp-section-heading"><div><p class="cp-kicker cp-kicker-dark"><span></span> CERPLUS’UN BUGÜN SUNDUKLARI</p><h2 id="cp-capabilities-title">Deponun dört işi.<br /><em>Tek çalışma alanı.</em></h2></div><p>Dağınık listelerden ortak bir depo düzenine.<br />Günlük işin ihtiyaç duyduğu bilgi, bir arada.</p></div><div class="cp-capability-list">{capabilities.map(item => <article class="cp-capability"><div class="cp-capability-index"><span>{item.number}</span><h3>{item.name}</h3></div><div class="cp-capability-copy"><h4>{item.title}</h4><p>{item.text}</p><div class="cp-capability-detail">{item.detail}</div></div><span class="cp-capability-tag">{item.tag}</span></article>)}</div></div></section>

    <section class="cp-section cp-role-section" aria-labelledby="cp-roles-title"><div class="container"><div class="cp-role-intro"><div><p class="cp-kicker"><span></span> HERKESE İHTİYACI KADAR ERİŞİM</p><h2 id="cp-roles-title">Aynı depo.<br /><em>Doğru kişiye, doğru bilgi.</em></h2></div><p>Operasyon ekibiniz depo işlerini yürütürken bayileriniz kendi stoklarını takip eder. Kullanıcı rolleri, işin sorumluluğuna göre ayrılır.</p></div><div class="cp-role-grid">{roles.map(role => <article><div class="cp-role-top"><span>{role.name}</span><span>{role.number}</span></div><h3>{role.title}</h3><p>{role.text}</p></article>)}</div><div class="cp-role-footer"><span aria-hidden="true">↳</span><p>Bayiye ait stok ile ortak depo stoğu ayrı tutulur. Bayi ekranında yalnızca ilgili bayinin kayıtları görünür.</p></div></div></section>

    <section class="cp-section cp-workflow" aria-labelledby="cp-workflow-title"><div class="container"><div class="cp-section-heading"><div><p class="cp-kicker cp-kicker-dark"><span></span> GÜNLÜK İŞİNİZE UYUM SAĞLAR</p><h2 id="cp-workflow-title">Koliyi kaydedin.<br /><em>Bilgiyi takip edin.</em></h2></div><p>Barkod okuyucu, manuel giriş veya Excel.<br />Kabul yöntemi değişse de kayıt düzeni aynı.</p></div><ol class="cp-workflow-list">{workflow.map(([title, text], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></li>)}</ol><div class="cp-excel-note"><span class="cp-file-icon" aria-hidden="true">XLSX</span><div><h3>Önce görün, sonra onaylayın.</h3><p>Excel aktarımında önizleme ve satır bazında hata kontrolü bulunur. Katalog yüklemek stok artırmaz; mal kabulü ayrı onaylanır. Aynı içeriğin tekrar aktarılması kayıtları çoğaltmaz.</p></div></div></div></section>

    <section class="cp-roadmap" aria-labelledby="cp-roadmap-title"><div class="container cp-roadmap-grid"><div><p class="cp-kicker cp-kicker-dark"><span></span> BİR SONRAKİ ADIM</p><h2 id="cp-roadmap-title">Depoda başlar.<br /><em>Teslimata doğru büyür.</em></h2><p>İlk sürümün odağı; katalog, mal kabul, stok ve depo hareketleri. Siparişten teslimata uzanan modüller geliştirme yol haritasında.</p></div><div class="cp-roadmap-panel"><span class="cp-roadmap-label">PLANLANAN SONRAKİ MODÜLLER</span>{nextModules.map((name, index) => <div><span>0{index + 2}</span><strong>{name}</strong><span class="cp-future-label">Planlanan</span></div>)}<p>Bu modüller mevcut sürümde kullanıma açık değildir.</p></div></div></section>

    <section class="cp-section cp-faq" aria-labelledby="cp-faq-title"><div class="container cp-faq-grid"><div><p class="cp-kicker cp-kicker-dark"><span></span> MERAK EDİLENLER</p><h2 id="cp-faq-title">İşe dair<br /><em>net cevaplar.</em></h2></div><div class="cp-faq-list"><details><summary>Katalog yüklemek ile mal kabul yapmak arasındaki fark nedir?<span aria-hidden="true">+</span></summary><p>Katalog, ürünün hangi koli tiplerinden oluştuğunu tanımlar. Stok miktarını artırmaz. Koliler depoya fiziksel olarak geldiğinde raf, sahip ve miktar bilgileriyle ayrı mal kabul yapılır.</p></details><details><summary>Barkod okuyucu olmadan kullanabilir miyiz?<span aria-hidden="true">+</span></summary><p>Evet. Barkodu elle yazabilir, manuel kabul yapabilir veya standart Excel şablonuyla toplu aktarım gerçekleştirebilirsiniz. Klavye gibi çalışan barkod okuyucular da kabul akışında kullanılabilir.</p></details><details><summary>Bayiler diğer bayilerin stoklarını görebilir mi?<span aria-hidden="true">+</span></summary><p>Hayır. Bayi hesabı yalnızca kendi bayisine ait stokları ve stok hareketlerini görür. Stok miktarlarını değiştirme yetkisi depo ve ofis operasyonundadır.</p></details></div></div></section>

    <section class="cp-closing" aria-labelledby="cp-closing-title"><div class="container cp-closing-inner"><div><p class="cp-kicker cp-kicker-dark"><span></span> DEPO DÜZENİNİZ İÇİN YENİ BİR ADIM</p><h2 id="cp-closing-title">İşiniz büyürken,<br /><em>kontrol sizde kalsın.</em></h2><p>Deponuzu, ürün yapınızı ve bayi çalışma düzeninizi konuşalım.<br />Cerplus’un işletmenize nasıl uyarlanacağını birlikte değerlendirelim.</p></div><div class="cp-closing-actions"><a class="cp-button cp-button-dark" href="/iletisim/#teklif">Cerplus hakkında görüşelim <span aria-hidden="true">↗</span></a><a class="cp-text-link" href={site.cerplusUrl}>Hesabınız var mı? Cerplus’a giriş →</a></div></div></section>
  </div>
</BaseLayout>
